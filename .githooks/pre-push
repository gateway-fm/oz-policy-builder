#!/usr/bin/env bash
# Scan every commit before it leaves the machine.
#
# Enable once per clone:
#
#     git config core.hooksPath .githooks
#
# Hooks are not tracked by git and not shared by cloning, which is why this lives in a tracked
# directory and is pointed at rather than copied into `.git/hooks`.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
REMOTE_NAME="${1:-}"
# git feeds the refs being pushed on stdin. Read them once so the publication gate can scan
# the commits that are actually leaving, including commits on a branch other than HEAD.
# Read once, into a variable, since stdin can only be consumed once.
REFS="$(cat)"

# ── Publication gate ─────────────────────────────────────────────────────────────────────
#
# Its strong half compares the tracked tree against the private root beside the repository, and
# that root exists on a working machine and nowhere else — CI checks out one repository and has
# nothing to compare against. So the check that can see what it is protecting runs at push time,
# and CI keeps the pattern-only half as the backstop for anything pushed with `--no-verify`.
#
# Scanned per pushed commit rather than at `HEAD`: pushing a branch that is not the one checked
# out is ordinary, and in that case `HEAD` is not what would become public.
echo "pre-push: publication gate"
zero='0000000000000000000000000000000000000000'
# Every commit the push introduces, not just each tip. A branch whose first commit adds a
# private file and whose second deletes it has a clean tip tree, and pushing it publishes the
# blob in history all the same.
introduced=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    [ "$local_sha" = "$zero" ] && continue                 # branch deletion
    if [ "${remote_sha:-$zero}" = "$zero" ]; then
        range=$(git rev-list "$local_sha" --not --remotes="$REMOTE_NAME")
    else
        range=$(git rev-list "$remote_sha..$local_sha")
    fi
    # A branch already on the remote introduces nothing; scan its tip so the push is still
    # checked rather than waved through on an empty range.
    [ -z "$range" ] && range="$local_sha"
    while read -r commit; do
        [ -n "$commit" ] && introduced+=("$commit")
    done <<< "$range"
done <<< "$REFS"

if [ "${#introduced[@]}" -gt 0 ]; then
    # `--require-private-root`: this is the machine where the comparison is possible, so a
    # root that yields nothing is a fault here even though it is normal on a CI runner.
    bash "$ROOT/scripts/check-publication-allowlist.sh" --require-private-root "${introduced[@]}"
fi
