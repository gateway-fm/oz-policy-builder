# Public operator settings only. The token and signed trust files are separate file inputs.
OZPB_RPC_ALLOWLIST=https://soroban-testnet.stellar.org
# 6 is the development registry's floor (testnet). A mainnet operator sets its own registry's
# version instead: the mainnet registry is its own chain, starting at version 1.
OZPB_REGISTRY_MIN_VERSION=6
OZPB_HTTP_REQUESTS_PER_MINUTE=60
OZPB_HTTP_TOOL_REQUESTS_PER_MINUTE=60
OZPB_HTTP_MAX_BODY_BYTES=8388608
OZPB_HTTP_MAX_CONCURRENCY=1
OZPB_BUILD_TIMEOUT_SECS=600
OZPB_BUILD_JOBS=1
