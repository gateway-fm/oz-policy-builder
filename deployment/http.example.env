# Public operator settings only. The token and signed trust files are separate file inputs.
OZPB_RPC_ALLOWLIST=https://rpc-testnet.stellar.org
OZPB_REGISTRY_MIN_VERSION=4
OZPB_HTTP_REQUESTS_PER_MINUTE=60
OZPB_HTTP_TOOL_REQUESTS_PER_MINUTE=60
OZPB_HTTP_MAX_BODY_BYTES=8388608
OZPB_HTTP_MAX_CONCURRENCY=1
OZPB_BUILD_TIMEOUT_SECS=600
OZPB_BUILD_JOBS=1
