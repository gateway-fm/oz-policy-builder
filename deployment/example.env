# These are public configuration values, not credentials. Keep actual files outside the repo.
# OZPB_IMAGE must identify an image built from the reviewed revision. Prefer a registry digest.
OZPB_IMAGE=sha256:REPLACE_WITH_LOCAL_IMAGE_ID_OR_REGISTRY_DIGEST
OZPB_PROXY_IMAGE=sha256:REPLACE_WITH_PROXY_IMAGE_ID_OR_REGISTRY_DIGEST
OZPB_HOSTNAME=localhost
OZPB_BIND_IP=127.0.0.1
OZPB_TLS_PORT=8443
OZPB_CONFIG_DIR=/absolute/private/ozpb-config
OZPB_RPC_ALLOWLIST=https://rpc-testnet.stellar.org
OZPB_REGISTRY_MIN_VERSION=4
OZPB_HTTP_REQUESTS_PER_MINUTE=60
OZPB_HTTP_MAX_BODY_BYTES=1048576
