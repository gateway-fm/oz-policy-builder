+
+/**
+ * `vite preview` serves a production build, and only it reaches the mainnet backend on 4318, for a
+ * build that recorded it was made for mainnet (preview-gate.mjs), whatever the shell running preview
+ * sets. The Cloudflare plugin answers every preview request itself, so this proxy is registered before it.
+ */
+const mainnetBackendProxy: Plugin = {
+  name: 'ozpb-mainnet-backend-proxy',
+  configurePreviewServer(server) {
+    const client = server.config.environments?.client?.build?.outDir ?? server.config.build.outDir
+    if (builtNetwork(resolve(server.config.root, client)) !== 'mainnet') return
+    server.middlewares.use('/api/policy-builder', (req, res) => {
+      const forward = request({ host: '127.0.0.1', port: 4318, method: req.method, path: `/api/policy-builder${req.url}`,
+        headers: req.headers }, (answer) => { res.writeHead(answer.statusCode ?? 502, answer.headers); answer.pipe(res) })
+      forward.on('error', () => { if (!res.headersSent) res.writeHead(502); res.end() })
+      req.pipe(forward)
+    })
+  },
+}
 
